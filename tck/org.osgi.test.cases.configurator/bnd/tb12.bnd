Bundle-SymbolicName: ${p}.tb12
Bundle-Name: tb12
Bundle-DocURL: http://www.osgi.org/
Bundle-ContactAddress: info@mail.osgi.org
Bundle-Category: osgi,test
Bundle-Copyright: ${copyright}

Import-Package: *

-includeresource: {OSGI-INF/configurator/config12a.json=configs/config12a.json}, \
    {OSGI-INF/configurator/config12b.json=configs/config12b.json}, \
    {OSGI-INF/configurator/config12c.json=configs/config12c.json}
Require-Capability: osgi.extender;filter:="(&(osgi.extender=osgi.configurator)(version>=1.0)(!(version>=2.0)))"
